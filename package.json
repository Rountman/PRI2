{
  "name": "erpsim-copilot",
  "private": true,
  "type": "module",
  "workspaces": [
    "config",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build -w @copilot/web",
    "game": "tsx scripts/game.ts",
    "game:share": "tsx scripts/game.ts --share"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
